{
  "name": "@becraft/sdk",
  "version": "0.1.1",
  "description": "SDK for interacting with the BeCraft backend APIs.",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/BeCraft-CMS/becraft-sdk.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/BeCraft-CMS/becraft-sdk/issues"
  },
  "homepage": "https://github.com/BeCraft-CMS/becraft-sdk#readme",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.js"
    }
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "jsdom": "^26.0.0"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist",
    "dev": "tsc --watch --project tsconfig.json",
    "fixpack": "fixpack",
    "format": "prettier --write .",
    "format:ci": "prettier --check .",
    "generate-api": "openapi-generator-cli generate -i http://localhost:8000/api-docs/openapi.json -g typescript-fetch -o ./src/api --skip-validate-spec",
    "lint": "eslint src --ext .ts",
    "lint:ci": "eslint src --ext .ts",
    "prepare": "npm run build",
    "test": "vitest",
    "test:watch": "vitest --watch"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@openapitools/openapi-generator-cli": "^2.18.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.6.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "fixpack": "^4.0.0",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.21.0",
    "typescript": "<5.7.0",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  }
}
